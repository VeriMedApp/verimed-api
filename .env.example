# Beispielkonfiguration fuer Project VeriMed.
# Kopieren nach `.env` und bei Bedarf anpassen.

# --- Lokal (SQLite) ---
DATABASE_URL=sqlite+aiosqlite:///./verimed.db

# --- Produktion (Render PostgreSQL) ---
# Render liefert postgresql://... – wird automatisch zu postgresql+asyncpg:// konvertiert.
# DATABASE_URL=postgresql://user:pass@host:5432/verimed

# Toleranzpuffer (Minuten) fuer die Zeit-Plausibilitaetspruefung.
TIME_TOLERANCE_MINUTES=10

# CORS: kommagetrennte Frontend-URLs oder "*" fuer alle.
ALLOWED_ORIGINS=*

# Verschluesselung (PII at rest) – in Produktion zwingend setzen!
# Generieren: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ENCRYPTION_KEY=

DEBUG=true
LOG_LEVEL=INFO
